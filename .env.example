# คัดลอกเป็น .env.local แล้วใส่ค่าจาก Supabase → Project Settings → API
# ไม่ใส่ก็รันได้: ใช้โหมดทดสอบบนเครื่อง (ห้องอยู่ในหน่วยความจำ, realtime เห็นกันเฉพาะแท็บในเบราว์เซอร์เดียวกัน)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron ส่งมาใน header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
