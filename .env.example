# คัดลอกเป็น .env.local แล้วใส่ค่าจาก Supabase → Project Settings → API
# ไม่ใส่ก็รันได้: ใช้โหมดทดสอบบนเครื่อง (ห้องอยู่ในหน่วยความจำ, realtime เห็นกันเฉพาะแท็บในเบราว์เซอร์เดียวกัน)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# ใช้กับ npm run db:migrate
POSTGRES_URL_NON_POOLING=

# ค้นเพลง dochord ผ่าน Brave Search (ไม่ใส่ก็ได้ ฟีเจอร์นี้จะปิดไว้) · https://api-dashboard.search.brave.com
BRAVE_SEARCH_API_KEY=
# จำนวนครั้งที่ถาม Brave ได้ต่อเดือน (ค่าเริ่ม 1000 = เครดิตฟรี $5)
BRAVE_MONTHLY_LIMIT=

# Vercel Cron ส่งมาใน header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
